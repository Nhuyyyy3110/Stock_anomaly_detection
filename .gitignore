__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.DS_Store

# Raw/intermediate/processed data files are local artifacts.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/interim/stock_data_by_ticker/
!data/interim/stock_data_by_ticker/.gitkeep
!data/processed/.gitkeep

# Trained models are generated by the pipeline.
models/*
!models/.gitkeep

# Generated reports, tables, figures, and logs.
results/figures/*
results/tables/*
results/reports/*
logs/*
!results/figures/eda/
!results/figures/eda/.gitkeep
!results/figures/anomaly_plots/
!results/figures/anomaly_plots/.gitkeep
!results/figures/model_comparison/
!results/figures/model_comparison/.gitkeep
!results/figures/sensitivity_analysis/
!results/figures/sensitivity_analysis/.gitkeep
!results/figures/news_analysis/
!results/figures/news_analysis/.gitkeep
!results/tables/.gitkeep
!results/reports/.gitkeep
!logs/.gitkeep
